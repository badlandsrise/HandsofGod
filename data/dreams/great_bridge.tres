[gd_resource type="Resource" script_class="DreamDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/defs/dream_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"great_bridge"
era = 2
text = "A bridge over the Great River, so we can walk home at night."
voice = "Our people work on the far bank and sleep there alone. We dream of a great bridge, so every night we can come home."
needs_buildings = {&"bridge": 1}
needs_population = 26
needs_regions = Array[StringName]([&"east_bank"])
wanderers = 3
quiet_before = 90.0
reward_faith = 15.0
