[gd_resource type="Resource" script_class="DreamDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/defs/dream_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"temple_of_the_hand"
era = 2
text = "A temple for the hand, with our hand painted on its doors."
voice = "We are a village now, with bread and bronze and cloth. By our fifth winter in this valley we will raise a temple where the shrine stands, big enough for all of us, with the hand on its doors."
gate = true
needs_buildings = {&"temple": 1}
needs_population = 50
needs_flags = Array[StringName]([&"harvest_festival"])
needs_regions = Array[StringName]([&"hill_quarry"])
needs_winters = 5
quiet_before = 120.0
reward_faith = 15.0
