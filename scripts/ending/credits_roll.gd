class_name CreditsRoll extends Control
## "Among the Stars": the credits roll over the city at night (DESIGN 9.2 beat 10).
## The people's names and the Book's memories are woven between the credits of
## CREDITS.md, so every roll is this village's own. It scrolls to its last card,
## holds it, then emits `finished`. Skippable after the first viewing: that is
## remembered in user://ending.cfg and mirrored in Game.options["credits_seen"].
##
##   var roll := CreditsRoll.new(); add_child(roll); roll.start(CreditsRoll.blocks(cast), 205.0)

signal finished

const SEEN_KEY := "credits_seen"
const CREAM := Color("#f4e6c8")
const GOLD := Color(1.0, 0.8, 0.48)
const DIM := Color(0.86, 0.8, 0.7)
const COLUMN := 820.0
const HOLD := 7.0

static var seen_path: String = "user://ending.cfg"   # tests point this elsewhere

var duration: float = 205.0
var t: float = 0.0
var rate: float = 1.0
var done: bool = false
var _col: VBoxContainer
var _shade: TextureRect
var _end_card: Control = null
var _travel: float = 0.0
var _started: bool = false

# ---------------------------------------------------------------- remembered

static func seen() -> bool:
	if bool(Game.options.get(SEEN_KEY, false)):
		return true
	var cf := ConfigFile.new()
	if cf.load(seen_path) == OK and bool(cf.get_value("ending", SEEN_KEY, false)):
		Game.options[SEEN_KEY] = true
		return true
	return false

static func mark_seen() -> void:
	Game.options[SEEN_KEY] = true
	var cf := ConfigFile.new()
	cf.load(seen_path)
	cf.set_value("ending", SEEN_KEY, true)
	cf.save(seen_path)

# ---------------------------------------------------------------- content

## The roll, as blocks {k: kind, t: text}: kinds title, sub, head, big, name,
## small, names, memory, line, gap, end.
static func blocks(cast: GoodbyeCast) -> Array:
	var b: Array = []
	var mem: Array = cast.memories(8) if cast != null else []
	var mi := [0]
	var memory := func() -> void:
		if mi[0] < mem.size():
			b.append({"k": "gap"})
			b.append({"k": "memory", "t": mem[mi[0]]})
			b.append({"k": "gap"})
			mi[0] += 1
	b.append({"k": "title", "t": "Hands of God"})
	b.append({"k": "sub", "t": "Among the Stars"})
	b.append({"k": "gap"})
	memory.call()
	if cast != null and not cast.crew.is_empty():
		b.append({"k": "head", "t": "The crew"})
		for i in cast.crew.size():
			var p = cast.crew[i]
			b.append({"k": "name", "t": ("Commander " if i == 0 else "") + str(p.given_name)})
			b.append({"k": "small", "t": BookData.cap(cast.relation(p))})
		memory.call()
	b.append({"k": "head", "t": "A game by"})
	b.append({"k": "big", "t": "Badlandsrise Game Studio"})
	memory.call()
	if cast != null:
		b.append({"k": "head", "t": "The people of the valley"})
		for row in cast.people_by_generation():
			b.append({"k": "small", "t": row[0]})
			b.append({"k": "names", "t": "   ".join(row[1])})
		memory.call()
		var gifts := cast.gift_kinds()
		if not gifts.is_empty():
			b.append({"k": "head", "t": "Taken with them"})
			b.append({"k": "names", "t": BookData.cap(BookData.join_names(gifts.map(func(g): return BookData.a_or_an(str(g)))))})
			memory.call()
	# ---- CREDITS.md
	b.append({"k": "head", "t": "Music and sound"})
	b.append({"k": "line", "t": "Composed and generated by Claude for Hands of God"})
	b.append({"k": "small", "t": "First Fire  ·  Long Furrows  ·  Market Bells  ·  Valley Lights"})
	b.append({"k": "small", "t": "The Last Evening  ·  Countdown  ·  Liftoff  ·  The Wave  ·  Goodbye  ·  Among the Stars"})
	b.append({"k": "small", "t": "Composed as MIDI, rendered with FluidSynth. Sound effects and the villagers' voices synthesised with numpy."})
	b.append({"k": "line", "t": "FluidR3_GM soundfont by Frank Wen (MIT licence)"})
	memory.call()
	b.append({"k": "head", "t": "Studio"})
	b.append({"k": "line", "t": "Badlandsrise Game Studio"})
	b.append({"k": "small", "t": "The studio splash, emblem, wordmark and sting were made in-engine for Hands of God by Claude"})
	b.append({"k": "head", "t": "Art"})
	b.append({"k": "small", "t": "All third-party art is CC0, credited with thanks"})
	for row in [
			["Ultimate Nature Pack", "Quaternius"], ["Medieval Village MegaKit", "Quaternius"],
			["Universal Base Characters", "Quaternius"], ["Universal Animation Library", "Quaternius"],
			["Farm Animals", "Quaternius"], ["Survival Kit", "Kenney"], ["Pirate Kit", "Kenney"],
			["City Kit (Industrial)", "Kenney"], ["City Kit (Commercial)", "Kenney"], ["Space Kit", "Kenney"],
			["Hand models and poses (godot-xr-tools)", "Miodrag Sejic (DigitalN8m4r3), GodotVR"]]:
		b.append({"k": "line", "t": "%s  —  %s" % row})
	b.append({"k": "small", "t": "The hand is a white cartoon glove modelled for Hands of God on the godot-xr-tools base hand."})
	b.append({"k": "small", "t": "The Village, Town and Launch kits, the props, the shaders and the textures were made for Hands of God, modelled in code."})
	memory.call()
	b.append({"k": "head", "t": "Ground textures"})
	b.append({"k": "line", "t": "ambientCG  ·  Poly Haven  ·  OpenGameArt contributors (CC0)"})
	b.append({"k": "head", "t": "Fonts"})
	b.append({"k": "line", "t": "Alegreya  —  Huerta Tipográfica"})
	b.append({"k": "line", "t": "IM Fell English  —  Igino Marini"})
	b.append({"k": "line", "t": "Caveat  —  Impallari Type"})
	b.append({"k": "small", "t": "SIL Open Font License 1.1"})
	b.append({"k": "head", "t": "Made with"})
	b.append({"k": "line", "t": "Godot Engine  (godotengine.org/license)"})
	while mi[0] < mem.size():
		memory.call()
	b.append({"k": "gap"})
	b.append({"k": "gap"})
	b.append({"k": "end", "t": "Thank you for watching over them."})
	return b

# ---------------------------------------------------------------- drawing

var driven: bool = false

func _init() -> void:
	name = "CreditsRoll"
	set_anchors_preset(Control.PRESET_FULL_RECT)
	mouse_filter = Control.MOUSE_FILTER_IGNORE
	modulate.a = 0.0

func start(content: Array, length: float = 205.0) -> void:
	duration = length
	t = 0.0
	done = false
	# a soft dark column so the names read over the lit city
	var g := Gradient.new()
	g.set_color(0, Color(0, 0, 0, 0.0))
	g.set_color(1, Color(0, 0, 0, 0.0))
	g.add_point(0.3, Color(0.02, 0.02, 0.04, 0.62))
	g.add_point(0.7, Color(0.02, 0.02, 0.04, 0.62))
	var gt := GradientTexture2D.new()
	gt.gradient = g
	gt.width = 256
	gt.height = 4
	_shade = TextureRect.new()
	_shade.texture = gt
	_shade.stretch_mode = TextureRect.STRETCH_SCALE
	_shade.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_shade.anchor_left = 0.5
	_shade.anchor_right = 0.5
	_shade.anchor_bottom = 1.0
	_shade.offset_left = -COLUMN * 0.82
	_shade.offset_right = COLUMN * 0.82
	add_child(_shade)
	_col = VBoxContainer.new()
	_col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_col.add_theme_constant_override(&"separation", 10)
	add_child(_col)
	for blk in content:
		_add(blk)
	_started = true
	_layout.call_deferred()

func _label(text: String, font: StringName, size: int, col: Color) -> Label:
	var l := Label.new()
	l.text = text
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	l.custom_minimum_size = Vector2(COLUMN, 0)
	l.add_theme_font_override(&"font", UiTheme.font(font))
	l.add_theme_font_size_override(&"font_size", size)
	l.add_theme_color_override(&"font_color", col)
	l.add_theme_color_override(&"font_shadow_color", Color(0, 0, 0, 0.8))
	l.add_theme_constant_override(&"shadow_offset_x", 0)
	l.add_theme_constant_override(&"shadow_offset_y", 2)
	l.add_theme_constant_override(&"shadow_outline_size", 6)
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return l

func _spacer(h: float) -> void:
	var c := Control.new()
	c.custom_minimum_size = Vector2(COLUMN, h)
	c.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_col.add_child(c)

func _add(blk: Dictionary) -> void:
	var text := str(blk.get("t", ""))
	match str(blk.get("k", "line")):
		"title":
			_spacer(40)
			_col.add_child(_label(text, &"title", 78, CREAM))
		"sub":
			_col.add_child(_label(text, &"title_italic", 36, GOLD))
		"head":
			_spacer(46)
			_col.add_child(_label(text, &"title_italic", 26, GOLD))
		"big":
			_col.add_child(_label(text, &"title", 46, CREAM))
		"name":
			_spacer(6)
			_col.add_child(_label(text, &"hand_bold", 46, CREAM))
		"small":
			_col.add_child(_label(text, &"italic", 21, DIM))
		"names":
			var l := _label(text, &"hand", 34, CREAM)
			l.add_theme_constant_override(&"line_spacing", -4)
			_col.add_child(l)
		"memory":
			var l := _label("“%s”" % text, &"title_italic", 27, Color(1.0, 0.86, 0.62))
			_col.add_child(l)
		"gap":
			_spacer(56)
		"end":
			_end_card = _label(text, &"title_italic", 40, CREAM)
			_col.add_child(_end_card)
			_spacer(40)
		_:
			_col.add_child(_label(text, &"body", 24, CREAM))

func _layout() -> void:
	if _col == null:
		return
	var vs := size if size.y > 0.0 else get_viewport_rect().size
	_col.reset_size()
	_col.position = Vector2((vs.x - COLUMN) * 0.5, vs.y)
	# travel until the end card sits in the middle of the screen
	var end_y := _col.size.y
	if _end_card != null:
		end_y = _end_card.position.y + _end_card.size.y * 0.5
	_travel = vs.y + end_y - vs.y * 0.5

func _process(delta: float) -> void:
	if driven:
		return
	var dt := Clock.real_delta if Clock.real_delta > 0.0 else delta
	advance(dt * rate)

## Steps the roll by `dt` seconds of its own time (the goodbye drives it, so a
## fast-forward or a paused frame moves the names with everything else).
func advance(dt: float) -> void:
	if not _started or done:
		return
	t += dt
	modulate.a = clampf(t / 2.5, 0.0, 1.0)
	var vs := size if size.y > 0.0 else get_viewport_rect().size
	var u := clampf(t / duration, 0.0, 1.0)
	_col.position.y = vs.y - _travel * u
	_col.position.x = (vs.x - COLUMN) * 0.5
	if t >= duration + HOLD:
		finish()

## Scroll position 0..1 (tests and shots read it).
func progress() -> float:
	return clampf(t / maxf(duration, 0.01), 0.0, 1.0)

## Jumps the roll to `u` (0..1) of its scroll.
func seek(u: float) -> void:
	t = clampf(u, 0.0, 1.0) * duration
	modulate.a = 1.0

func finish() -> void:
	if done:
		return
	done = true
	mark_seen()
	finished.emit()
