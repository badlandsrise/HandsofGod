; Engine configuration file.
config_version=5

[application]
config/name="Hands of God"
run/main_scene="res://scenes/front/boot.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]
Events="*res://autoload/events.gd"
Defs="*res://autoload/defs.gd"
Clock="*res://autoload/clock.gd"
Faith="*res://autoload/faith.gd"
Village="*res://autoload/village.gd"
Save="*res://autoload/save.gd"
Audio="*res://autoload/audio.gd"
Game="*res://autoload/game.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]
; actions are registered in code by Game._register_input() so they stay in one place

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
limits/global_shader_variables/buffer_size=262144

[hands_of_god]

ground_look="photo"
